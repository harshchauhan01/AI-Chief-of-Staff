{
  "name": "Orion",
  "short_name": "Orion",
  "description": "Plan goals, tasks, routines, and daily progress from your phone.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f3eb",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "/orion-app-icon.svg?v=2",
      "sizes": "48x48",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/orion-app-icon.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable any"
    }
  ],
  "share_target": {
    "action": "/money-tracker",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "shortcuts": [
    {
      "name": "Add Expense",
      "short_name": "Add Expense",
      "description": "Quickly log a new expense",
      "url": "/quick-add",
      "icons": [
        {
          "src": "/orion-app-icon.svg?v=2",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Money Tracker",
      "short_name": "Money Tracker",
      "description": "View this month's spending",
      "url": "/money-tracker",
      "icons": [
        {
          "src": "/orion-app-icon.svg?v=2",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}